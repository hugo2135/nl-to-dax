{
  "filterId": "refund_analysis",
  "name": "退費訂單分析",
  "description": "專門分析退費相關訂單，覆蓋預設篩選，只顯示 order_type 為 return_order 或 order_status 為 refunded 的訂單。",
  "alwaysApply": false,
  "overrideDefaults": true,
  "contextKeywords": ["退費", "退款", "refund", "退貨", "退單", "return_order"],
  "filters": [
    {
      "description": "只顯示退費相關訂單",
      "expression": "all_orders_tw_zone[order_type] = \"return_order\" || all_orders_tw_zone[order_status] = \"refunded\"",
      "requiredTable": "all_orders_tw_zone"
    }
  ]
}
